# Copy to .env and fill in. Never commit the real .env.
#
# Local dev needs OAUTHLIB_INSECURE_TRANSPORT=1 (set by scripts/run_local.sh)
# since oauthlib enforces HTTPS by default and would otherwise reject the
# http://localhost redirect URI used for testing. Never set it in production.

# --- Google OAuth ---------------------------------------------------------
# REQUIRED IN PRODUCTION. Google echoes the requested `email` scope back as
# https://www.googleapis.com/auth/userinfo.email, and oauthlib treats any scope
# mismatch as fatal, raising a bare `Warning` from fetch_token. Without this the
# callback fails for EVERY user. It was previously set only in
# scripts/run_local.sh, so the first real deployment 500'd on every sign-in.
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev: Google permits http://localhost redirect URIs specifically.
# Production: https://wifi.example.org/callback
# Google will NEVER accept a bare IP or a non-public TLD here - don't try.
OAUTH_REDIRECT_URI=http://localhost:5000/callback
HOSTED_DOMAIN=example.org

# --- Which directory decides student vs staff -----------------------------
# ldap      = Google Secure LDAP (currently proven on the server)
# directory = Google Admin Directory API (simpler; see directory_client.py)
IDENTITY_BACKEND=ldap

# Used when IDENTITY_BACKEND=ldap
LDAP_HOST=ldap.google.com
LDAP_PORT=636
LDAP_CERT_FILE=./certs/google-ldap.crt
LDAP_KEY_FILE=./certs/google-ldap.key
LDAP_BASE_DN=ou=Users,dc=example,dc=org
# Optional explicit CA bundle. Leave blank to use the system trust store.
LDAP_CA_FILE=
# Escape hatch ONLY. 1 disables validation of ldap.google.com's certificate,
# which would let anyone on the path decide who counts as staff.
LDAP_TLS_INSECURE=0

# Used when IDENTITY_BACKEND=directory
DIRECTORY_SA_FILE=
DIRECTORY_IMPERSONATE=

# --- OU / SSID policy -----------------------------------------------------
# Copy ou-policy.conf.example here and verify with scripts/preflight.py.
POLICY_FILE=./instance/ou-policy.conf

# --- UniFi ----------------------------------------------------------------
UNIFI_HOST=192.168.1.1
UNIFI_SITE=default
# apikey = X-API-KEY (preferred; UniFi OS Settings -> Integrations -> Create API Key)
# login  = username/password + CSRF (fallback; needs a LOCAL admin account)
# mock   = no network calls at all (local dev / tests)
UNIFI_MODE=mock
UNIFI_API_KEY=
# Only for UNIFI_MODE=login
UNIFI_USER=
UNIFI_PASS=

# --- Session store & authorization ---------------------------------------
SESSION_DB_PATH=./instance/sessions.db
SESSION_TTL_SECONDS=600
# 43200 minutes = 30 days
AUTHORIZE_MINUTES=43200
PORT=5000

# Set to 1 when nginx terminates TLS in front of this app. Leaving it at 0
# behind a proxy makes the app see http:// and breaks the OAuth token
# exchange with a redirect-URI mismatch. Set to 0 when nothing is in front.
TRUST_PROXY_HOPS=0
# 127.0.0.1 keeps the dev server off the LAN; nginx proxies to it.
BIND_HOST=127.0.0.1

# --- Logging --------------------------------------------------------------
# One line per attempt: email, mac, ssid, ou, result
CONNECTION_LOG_PATH=./instance/connections.log
# Optional: one blocked email per line, '#' comments allowed. Need not exist.
BLOCKLIST_FILE=./instance/block_email.txt
LOG_LEVEL=INFO

# --- Guest access codes -------------------------------------------------------
# Off by default so the feature can be deployed dark and switched on once the
# front office has codes to hand out. With it off, /guest and /staff/vouchers
# return 404.
VOUCHERS_ENABLED=0
VOUCHER_DB_PATH=./instance/vouchers.db

# Brute-force limits for code entry. The codes UniFi generates are 10 digits and
# the guest is on an OPEN SSID, so an unbounded attempt rate makes the keyspace
# irrelevant. Counted per MAC and per source address.
VOUCHER_MAX_ATTEMPTS=5
VOUCHER_ATTEMPT_WINDOW=900

# Signs the staff session cookie for /staff/vouchers. REQUIRED when
# VOUCHERS_ENABLED=1 - the app refuses to start without it rather than serving
# an unsigned cookie. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
STAFF_SESSION_MINUTES=60

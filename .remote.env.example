# Connection details for scripts/remote.py. Copy to .remote.env (gitignored).
# Kept in a file rather than passed on the command line so no credential ends
# up in shell history, a process list, or a Claude Code transcript.

SSH_HOST=192.168.1.50
SSH_USER=it_admin
SSH_PORT=22

# Password auth. Prefer a key (below) and leave this blank once one is installed.
SSH_PASS=

# Key auth. SSH_KEY_INSTALLED must be 1 before the key is attempted at all -
# trying a key that the server doesn't have costs a failed auth on every call,
# which trips sshd rate limiting after a handful of commands.
SSH_KEY=~/.ssh/wifi_portal
SSH_KEY_INSTALLED=0

# Where `remote.py push` uploads wifi-portal/ to.
REMOTE_DIR=/home/it_admin/portal
